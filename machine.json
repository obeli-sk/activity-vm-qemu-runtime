{
  "ram": "256M",
  "cpu_hotplug": { "max": 16 },
  "hotplug": { "device": "vmem", "max_bytes": 17179869184, "block_bytes": 2097152 },
  "store_image_bytes": 17179869184,
  "mailbox_vsock": true,
  "args": [
    "-nographic",
    "-cpu", "Haswell-v4,+rdrand,vendor=GenuineIntel",
    "-device", "virtio-rng-pci",
    "-smp", "1,maxcpus=16",
    "-m", "{ram},maxmem=17G",
    "-machine", "pc,memory-backend=mem0",
    "-object", "memory-backend-memfd,id=mem0,size={ram},share=on",
    "-object", "memory-backend-memfd,id=vmem0,size=16G,reserve=off,share=on",
    "-device", "virtio-mem-pci,id=vmem,memdev=vmem0,requested-size=0,block-size=2M",
    "-accel", "tcg,tb-size=500",
    "-L", "{pack}/",
    "-nic", "none",
    "-kernel", "{pack}/bzImage",
    "-initrd", "{pack}/initramfs.cpio.gz",
    "-drive", "file={image},if=none,id=store0,format=raw,readonly=on",
    "-device", "virtio-blk-pci,drive=store0",
    "-chardev", "socket,id=vsock0,path={vhost}",
    "-append", "console=ttyS0 rdinit=/init loglevel=4 mitigations=off rcupdate.rcu_expedited=1 noreplace-smp"
  ]
}
