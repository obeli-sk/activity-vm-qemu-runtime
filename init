#!/bin/sh
set -eu

export PATH=/bin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /share /obelisk-activity-vm-http /obelisk-activity /tmp
ip link set lo up
nft -f /usr/share/obelisk/activity-vm.nft
# The default heuristic rejects single commits near guest RAM size, such as V8's 512 MiB code range.
echo 1 > /proc/sys/vm/overcommit_memory
echo 'obelisk-native-qemu: ready for snapshot'

# The host sends its wall clock; the snapshot's clock is frozen at build time.
IFS=' ' read -r now cpus < /dev/console
/bin/reseed
[ -z "$now" ] || /bin/settime "$now"
# The host hot-adds vCPUs before sending the clock. ACPI registers them asynchronously and
# Linux leaves them offline; the boot CPU has no online file.
if [ "${cpus:-1}" -gt 1 ]; then
  while [ "$(ls /sys/devices/system/cpu/cpu*/online 2>/dev/null | wc -l)" -lt "$((cpus - 1))" ]; do
    usleep 1000
  done
  for online in /sys/devices/system/cpu/cpu*/online; do
    [ "$(cat "$online")" = 1 ] || echo 1 > "$online"
  done
fi
# The host plugs extra RAM before sending the clock; the rootfs size limit was fixed at boot.
mount -o remount,size=90% /
if [ -x /bin/mailbox ]; then echo 1 > /sys/bus/pci/rescan; fi
if [ -b /dev/vda ]; then
  mount -t erofs -o ro /dev/vda /share
else
  mount -t 9p -o trans=virtio,version=9p2000.L,msize=1048576,cache=loose,negtimeout=0 store0 /share
fi
if [ -x /bin/mailbox ]; then
  mount -t tmpfs -o mode=0755 mailbox /obelisk-activity-vm-http
else
  mount -t 9p -o trans=virtio,version=9p2000.L,msize=8192,cache=none queue0 /obelisk-activity-vm-http
fi
rm -rf /nix /obelisk-activity
ln -s /share/nix /nix
ln -s /share/obelisk-activity /obelisk-activity
echo 'obelisk-native-qemu: shares mounted'
if [ -x /bin/mailbox ]; then
  /bin/mailbox /obelisk-activity-vm-http 1024 &
  while [ ! -f /obelisk-activity-vm-http/run.sh ]; do usleep 1000; done
fi
/bin/sh /obelisk-activity-vm-http/run.sh
while :; do sleep 3600; done
